# 已上线的薯数地址
SHUSHU_API_URL=https://shushureview.cn

# 仅保存在采集电脑中，不要提交到 GitHub
SHUSHU_COLLECTOR_TOKEN=replace-with-your-collector-token

# 当前账号的稳定标识；换电脑时必须沿用原值，避免被识别成新账号
XHS_PLATFORM_ACCOUNT_ID=replace-with-existing-platform-account-id

# 单次同步最近发布的 5 篇内容
SHUSHU_NOTE_LIMIT=5

# 连续采集模式的轮询间隔
SHUSHU_INTERVAL_MINUTES=10
