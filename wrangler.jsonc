{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shushu-xhs-review",
  "account_id": "b79834f651a2ab42da319340bbd29875",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "routes": [
    {
      "pattern": "shushureview.cn",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shushu-review-db",
      "database_id": "e4f1f439-5cec-460f-9d04-cc18cc83832d",
      "migrations_dir": "drizzle"
    }
  ]
}
